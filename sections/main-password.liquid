<section class="section section--password" data-section-id="{{ section.id }}">
  <div class="password">
    <h1 class="password__heading">{{ section.settings.heading | default: shop.name }}</h1>
    <p class="password__text">{{ section.settings.subheading }}</p>
    {% form 'storefront_password', class: 'password__form' %}
      <label for="Password-{{ section.id }}" class="password__label">{{ 'general.password_page.enter_password' | t }}</label>
      <input id="Password-{{ section.id }}" name="password" type="password" class="password__input">
      <button class="btn btn--primary" type="submit">{{ 'general.password_page.submit' | t }}</button>
      {% if form.errors %}
        <div class="password__errors">{{ form.errors | default_errors }}</div>
      {% endif %}
    {% endform %}
    {% if section.settings.show_signup %}
      <div class="password__signup">
        {{ 'general.password_page.signup_heading' | t }}
        {% if shop.password_message != blank %}
          <p>{{ shop.password_message }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "checkbox",
      "id": "show_signup",
      "label": "Show signup message",
      "default": true
    }
  ]
}
{% endschema %}
