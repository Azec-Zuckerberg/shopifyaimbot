<section class="section section--cart" data-section-id="{{ section.id }}">
  <div class="cart">
    <h1 class="cart__heading">{{ 'cart.title' | t }}</h1>
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="cart__table">
          <thead>
            <tr>
              <th scope="col">{{ 'cart.label.product' | t }}</th>
              <th scope="col">{{ 'cart.label.price' | t }}</th>
              <th scope="col">{{ 'cart.label.quantity' | t }}</th>
              <th scope="col">{{ 'cart.label.total' | t }}</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="cart__row">
                <td data-label="{{ 'cart.label.product' | t }}">
                  <a class="cart__product" href="{{ item.url }}">
                    {% if item.image %}
                      {{ item.image | image_url: width: 150 | image_tag: loading: 'lazy', alt: item.product.title }}
                    {% endif %}
                    <span>
                      {{ item.product.title }}
                      {% unless item.product.has_only_default_variant %}
                        <small>{{ item.variant.title }}</small>
                      {% endunless %}
                    </span>
                  </a>
                </td>
                <td data-label="{{ 'cart.label.price' | t }}">{{ item.price | money }}</td>
                <td data-label="{{ 'cart.label.quantity' | t }}">
                  <input
                    class="cart__quantity"
                    type="number"
                    name="updates[{{ item.key }}]"
                    value="{{ item.quantity }}"
                    min="0"
                    aria-label="{{ 'cart.label.quantity' | t }}"
                  >
                </td>
                <td data-label="{{ 'cart.label.total' | t }}">{{ item.final_line_price | money }}</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="cart__footer">
          <p class="cart__subtotal">
            <span>{{ 'cart.general.subtotal' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </p>
          <div class="cart__actions">
            <button type="submit" name="update" class="btn btn--ghost">{{ 'cart.general.update' | t }}</button>
            <button type="submit" name="checkout" class="btn btn--primary">{{ 'cart.general.checkout' | t }}</button>
          </div>
        </div>
      </form>
    {% else %}
      <p>{{ 'cart.general.empty' | t }}</p>
      <a class="btn btn--primary" href="{{ routes.collections_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main cart",
  "settings": []
}
{% endschema %}
