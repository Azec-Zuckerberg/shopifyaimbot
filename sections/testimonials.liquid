<section class="section section--testimonials" id="Testimonials" data-section-id="{{ section.id }}">
  <div class="testimonials">
    <div class="testimonials__intro">
      <h2 class="testimonials__title">{{ section.settings.heading }}</h2>
      <p class="testimonials__subtitle">{{ section.settings.subheading }}</p>
    </div>
    <div class="testimonials__list">
      {% for block in section.blocks %}
        <figure class="testimonial" {{ block.shopify_attributes }}>
          <blockquote class="testimonial__quote">“{{ block.settings.quote }}”</blockquote>
          <figcaption class="testimonial__meta">
            <span class="testimonial__name">{{ block.settings.name }}</span>
            {% if block.settings.role %}
              <span class="testimonial__role">{{ block.settings.role }}</span>
            {% endif %}
          </figcaption>
        </figure>
      {% else %}
        <p class="testimonials__placeholder">
          {{ 'sections.testimonials.placeholder' | t }}
          <span class="todo-note">TODO: migrate quotes from existing marketing site.</span>
        </p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Trusted by elite squads"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real feedback from long-time customers across multiple regions."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "We gained instant access with zero downtime."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Player 1"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role / Team"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
