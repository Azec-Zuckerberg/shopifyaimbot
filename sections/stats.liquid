<section class="section section--stats" data-section-id="{{ section.id }}">
  <div class="stats">
    <div class="stats__intro">
      <h2 class="stats__title">{{ section.settings.heading }}</h2>
      <p class="stats__subtitle">{{ section.settings.subheading }}</p>
    </div>
    <dl class="stats__grid">
      {% for block in section.blocks %}
        <div class="stats__item" {{ block.shopify_attributes }}>
          <dt class="stats__value">{{ block.settings.value }}</dt>
          <dd class="stats__label">{{ block.settings.label }}</dd>
        </div>
      {% endfor %}
    </dl>
  </div>
</section>

{% schema %}
{
  "name": "Stats",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Numbers that matter"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real usage data gathered from the original site analytics."
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "24/7"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Support coverage"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Stats",
      "blocks": [
        { "type": "stat" },
        { "type": "stat" },
        { "type": "stat" }
      ]
    }
  ]
}
{% endschema %}
