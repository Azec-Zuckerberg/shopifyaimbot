<section class="section section--contact" data-section-id="{{ section.id }}">
  <div class="contact">
    <div class="contact__intro">
      <h1 class="contact__heading">{{ section.settings.heading }}</h1>
      <p class="contact__text">{{ section.settings.text }}</p>
      {% if section.settings.support_email %}
        <p class="contact__support">
          {{ 'sections.contact.support_text' | t }} <a href="mailto:{{ section.settings.support_email }}">{{ section.settings.support_email }}</a>
        </p>
      {% endif %}
    </div>
    <div class="contact__form">
      {% form 'contact', id: 'ContactForm', class: 'contact-form' %}
        {% if form.posted_successfully? %}
          <p class="contact-form__success">{{ 'sections.contact.success' | t }}</p>
        {% endif %}
        {% if form.errors %}
          <div class="contact-form__errors">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        <label class="contact-form__field">
          <span>{{ 'sections.contact.fields.name' | t }}</span>
          <input type="text" name="contact[name]" value="{{ form.name }}" required>
        </label>
        <label class="contact-form__field">
          <span>{{ 'sections.contact.fields.email' | t }}</span>
          <input type="email" name="contact[email]" value="{{ form.email }}" required>
        </label>
        <label class="contact-form__field">
          <span>{{ 'sections.contact.fields.message' | t }}</span>
          <textarea name="contact[body]" rows="5" required>{{ form.body }}</textarea>
        </label>
        <button class="btn btn--primary" type="submit">{{ section.settings.button_label }}</button>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Let us know which platform you play on and what you need unlocked."
    },
    {
      "type": "text",
      "id": "support_email",
      "label": "Support email"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Submit label",
      "default": "Send message"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
