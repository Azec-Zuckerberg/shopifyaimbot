<section class="section section--blog" data-section-id="{{ section.id }}">
  <div class="blog">
    <h1 class="blog__heading">{{ blog.title }}</h1>
    {% if blog.articles_count > 0 %}
      <div class="blog__grid">
        {% paginate blog.articles by section.settings.articles_per_page %}
          {% for article in blog.articles %}
            <article class="blog-card">
              <h2 class="blog-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <p class="blog-card__meta">{{ article.published_at | date: "%B %d, %Y" }}</p>
              <div class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 160 }}</div>
              <a class="blog-card__link" href="{{ article.url }}">{{ 'blogs.article.read_more' | t }}</a>
            </article>
          {% endfor %}
          {% if paginate.pages > 1 %}
            {% render 'pagination', paginate: paginate %}
          {% endif %}
        {% endpaginate %}
      </div>
    {% else %}
      <p>{{ 'blogs.article.no_articles' | t }}</p>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Main blog",
  "settings": [
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 12,
      "step": 3,
      "default": 6
    }
  ]
}
{% endschema %}
