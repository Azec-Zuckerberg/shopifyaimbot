<section class="section section--register" data-section-id="{{ section.id }}">
  <div class="customer customer--register">
    <h1 class="customer__heading">{{ 'customer.register.title' | t }}</h1>
    {% form 'create_customer' %}
      {% if form.errors %}
        <div class="customer__errors">{{ form.errors | default_errors }}</div>
      {% endif %}
      <label class="customer__field">
        <span>{{ 'customer.register.first_name' | t }}</span>
        <input type="text" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
      </label>
      <label class="customer__field">
        <span>{{ 'customer.register.last_name' | t }}</span>
        <input type="text" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
      </label>
      <label class="customer__field">
        <span>{{ 'customer.register.email' | t }}</span>
        <input type="email" name="customer[email]" value="{{ form.email }}" autocomplete="email" required>
      </label>
      <label class="customer__field">
        <span>{{ 'customer.register.password' | t }}</span>
        <input type="password" name="customer[password]" autocomplete="new-password" required>
      </label>
      <button class="btn btn--primary" type="submit">{{ 'customer.register.submit' | t }}</button>
    {% endform %}
    <div class="customer__meta">
      <p>{{ 'customer.register.already_account' | t }}</p>
      <a class="btn btn--ghost" href="{{ routes.account_login_url }}">{{ 'customer.login.sign_in' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer register",
  "settings": []
}
{% endschema %}
