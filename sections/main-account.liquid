<section class="section section--account" data-section-id="{{ section.id }}">
  <div class="account">
    <h1 class="account__heading">{{ 'customer.account.title' | t }}</h1>
    <p class="account__welcome">{{ 'customer.account.welcome' | t: name: customer.first_name | default: customer.email }}</p>
    <div class="account__content">
      <div class="account__orders">
        <h2>{{ 'customer.orders.title' | t }}</h2>
        {% if customer.orders_count > 0 %}
          <table class="account__table">
            <thead>
              <tr>
                <th>{{ 'customer.orders.order_number' | t }}</th>
                <th>{{ 'customer.orders.date' | t }}</th>
                <th>{{ 'customer.orders.payment_status' | t }}</th>
                <th>{{ 'customer.orders.fulfillment_status' | t }}</th>
                <th>{{ 'customer.orders.total' | t }}</th>
              </tr>
            </thead>
            <tbody>
              {% for order in customer.orders %}
                <tr>
                  <td data-label="{{ 'customer.orders.order_number' | t }}">
                    <a href="{{ order.customer_url }}">{{ order.name }}</a>
                  </td>
                  <td data-label="{{ 'customer.orders.date' | t }}">{{ order.created_at | date: "%B %d, %Y" }}</td>
                  <td data-label="{{ 'customer.orders.payment_status' | t }}">{{ order.financial_status_label }}</td>
                  <td data-label="{{ 'customer.orders.fulfillment_status' | t }}">{{ order.fulfillment_status_label }}</td>
                  <td data-label="{{ 'customer.orders.total' | t }}">{{ order.total_price | money }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        {% else %}
          <p>{{ 'customer.orders.none' | t }}</p>
        {% endif %}
      </div>
      <div class="account__details">
        <h2>{{ 'customer.account.details' | t }}</h2>
        <p>{{ customer.default_address | format_address }}</p>
        <a class="btn btn--ghost" href="{{ routes.account_addresses_url }}">{{ 'customer.account.view_addresses' | t: count: customer.addresses_count }}</a>
        <a class="btn btn--ghost" href="{{ routes.account_logout_url }}">{{ 'customer.account.logout' | t }}</a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer account",
  "settings": []
}
{% endschema %}
