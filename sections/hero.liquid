{% liquid
  assign desktop_image = section.settings.background_image
  assign mobile_image = section.settings.background_image_mobile | default: desktop_image
%}

<section class="section section--hero" data-section-id="{{ section.id }}">
  <div class="hero">
    {% if desktop_image %}
      <picture class="hero__media">
        <source media="(max-width: 640px)" srcset="{{ mobile_image | image_url: width: 900 }}">
        {{ desktop_image | image_url: width: 1600 | image_tag: alt: section.settings.heading, loading: 'lazy' }}
      </picture>
    {% endif %}
    <div class="hero__content">
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
      <p class="hero__subtitle">{{ section.settings.subheading }}</p>
      <div class="hero__actions">
        {% if section.settings.primary_label and section.settings.primary_link %}
          <a class="btn btn--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
        {% endif %}
        {% if section.settings.secondary_label and section.settings.secondary_link %}
          <a class="btn btn--secondary" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>
      {% if section.settings.highlight_text %}
        <p class="hero__highlight">{{ section.settings.highlight_text }}</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "New release"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Unlock peak performance"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Optimized tools and services trusted by top-ranked players."
    },
    {
      "type": "text",
      "id": "highlight_text",
      "label": "Highlight text",
      "default": "Fast setup · Secure delivery · 24/7 support"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "image_picker",
      "id": "background_image_mobile",
      "label": "Mobile background image"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Explore offers"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
