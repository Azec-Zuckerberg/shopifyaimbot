<section class="section section--reset-password" data-section-id="{{ section.id }}">
  <div class="customer customer--reset">
    <h1 class="customer__heading">{{ 'customer.reset_password.title' | t }}</h1>
    {% form 'reset_customer_password' %}
      {% if form.errors %}
        <div class="customer__errors">{{ form.errors | default_errors }}</div>
      {% endif %}
      <label class="customer__field">
        <span>{{ 'customer.reset_password.password' | t }}</span>
        <input type="password" name="customer[password]" autocomplete="new-password" required>
      </label>
      <label class="customer__field">
        <span>{{ 'customer.reset_password.password_confirm' | t }}</span>
        <input type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </label>
      <button class="btn btn--primary" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Reset password",
  "settings": []
}
{% endschema %}
