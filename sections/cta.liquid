<section class="section section--cta" data-section-id="{{ section.id }}">
  <div class="cta">
    <div class="cta__content">
      <h2 class="cta__heading">{{ section.settings.heading }}</h2>
      <p class="cta__text">{{ section.settings.text }}</p>
      {% if section.settings.primary_label and section.settings.primary_link %}
        <a class="btn btn--primary" href="{{ section.settings.primary_link }}">{{ section.settings.primary_label }}</a>
      {% endif %}
      {% if section.settings.secondary_label and section.settings.secondary_link %}
        <a class="btn btn--ghost" href="{{ section.settings.secondary_link }}">{{ section.settings.secondary_label }}</a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call to action",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to unlock everything?"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Supporting text",
      "default": "Pick your platform and enable full access with a single click."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Browse bundles"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Call to action"
    }
  ]
}
{% endschema %}
