<section class="section section--feature-grid" data-section-id="{{ section.id }}">
  <div class="feature-grid">
    <div class="feature-grid__intro">
      <h2 class="feature-grid__title">{{ section.settings.heading }}</h2>
      <p class="feature-grid__subtitle">{{ section.settings.subheading }}</p>
    </div>
    <div class="feature-grid__items">
      {% for block in section.blocks %}
        <article class="feature-grid__item" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="feature-grid__icon">
              {% render 'icon', name: block.settings.icon %}
            </div>
          {% endif %}
          <h3 class="feature-grid__heading">{{ block.settings.title }}</h3>
          <p class="feature-grid__text">{{ block.settings.text }}</p>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Feature grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why players choose us"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Tools that keep your account secure and maximize results."
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "bolt", "label": "Bolt" },
            { "value": "target", "label": "Target" },
            { "value": "clock", "label": "Clock" },
            { "value": "star", "label": "Star" }
          ]
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Secure delivery"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Accounts protected with multi-layer authentication and real-time monitoring."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Feature grid",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
