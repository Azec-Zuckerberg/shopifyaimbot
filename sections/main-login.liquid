<section class="section section--login" data-section-id="{{ section.id }}">
  <div class="customer customer--login">
    <h1 class="customer__heading">{{ 'customer.login.title' | t }}</h1>
    {% form 'customer_login' %}
      {% if form.errors %}
        <div class="customer__errors">{{ form.errors | default_errors }}</div>
      {% endif %}
      <label class="customer__field">
        <span>{{ 'customer.login.email' | t }}</span>
        <input type="email" name="customer[email]" autocomplete="email" required>
      </label>
      <label class="customer__field">
        <span>{{ 'customer.login.password' | t }}</span>
        <input type="password" name="customer[password]" autocomplete="current-password" required>
      </label>
      <button class="btn btn--primary" type="submit">{{ 'customer.login.sign_in' | t }}</button>
      <a class="customer__link" href="{{ routes.account_recover_url }}">{{ 'customer.login.forgot_password' | t }}</a>
    {% endform %}
    <div class="customer__meta">
      <p>{{ 'customer.login.guest_title' | t }}</p>
      <a class="btn btn--ghost" href="{{ routes.account_register_url }}">{{ 'customer.login.create_account' | t }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer login",
  "settings": []
}
{% endschema %}
