<section class="section section--list-collections" data-section-id="{{ section.id }}">
  <div class="list-collections">
    <h1 class="list-collections__heading">{{ 'collections.general.title' | t }}</h1>
    <div class="list-collections__grid">
      {% for collection in collections %}
        {% if collection.all_products_count > 0 %}
          <article class="collection-card">
            <a href="{{ collection.url }}">
              {% if collection.image %}
                {{ collection.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: collection.title }}
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag }}
              {% endif %}
              <h2 class="collection-card__title">{{ collection.title }}</h2>
            </a>
          </article>
        {% endif %}
      {% else %}
        <p>{{ 'collections.general.no_matches' | t }}</p>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection list",
  "settings": []
}
{% endschema %}
