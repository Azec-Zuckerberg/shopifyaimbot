<section class="section section--404" data-section-id="{{ section.id }}">
  <div class="not-found">
    <h1 class="not-found__heading">{{ 'general.404.title' | t }}</h1>
    <p class="not-found__text">{{ 'general.404.subtext' | t }}</p>
    <a class="btn btn--primary" href="{{ routes.root_url }}">{{ 'general.404.link' | t }}</a>
  </div>
</section>

{% schema %}
{
  "name": "404 content",
  "settings": []
}
{% endschema %}
