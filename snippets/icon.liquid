{% case name %}
{% when 'shield' %}
  <svg class="icon icon--shield" width="24" height="24" aria-hidden="true" viewBox="0 0 24 24">
    <path d="M12 3l8 3v6c0 4.9-3.4 9.5-8 10-4.6-.5-8-5-8-10V6l8-3z" fill="currentColor"/>
  </svg>
{% when 'bolt' %}
  <svg class="icon icon--bolt" width="24" height="24" aria-hidden="true" viewBox="0 0 24 24">
    <path d="M13 2L3 14h7l-1 8 10-12h-7l1-8z" fill="currentColor"/>
  </svg>
{% when 'target' %}
  <svg class="icon icon--target" width="24" height="24" aria-hidden="true" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none"/>
    <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="2" fill="none"/>
    <circle cx="12" cy="12" r="2" fill="currentColor"/>
  </svg>
{% when 'clock' %}
  <svg class="icon icon--clock" width="24" height="24" aria-hidden="true" viewBox="0 0 24 24">
    <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2" fill="none"/>
    <path d="M12 7v5l4 2" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{% when 'star' %}
  <svg class="icon icon--star" width="24" height="24" aria-hidden="true" viewBox="0 0 24 24">
    <path d="M12 3l2.9 6.6 7.1.6-5.3 4.6 1.6 6.9L12 17.9 5.7 21l1.6-6.9L2 10.2l7.1-.6L12 3z" fill="currentColor"/>
  </svg>
{% when 'instagram' %}
  <svg class="icon icon--instagram" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <rect x="3" y="3" width="18" height="18" rx="4" ry="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5" fill="none"/>
    <circle cx="17" cy="7" r="1" fill="currentColor"/>
  </svg>
{% when 'tiktok' %}
  <svg class="icon icon--tiktok" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M16 3h3a6 6 0 0 0 1 4 5 5 0 0 1-4-2v9a4 4 0 1 1-4-4h1" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
{% when 'youtube' %}
  <svg class="icon icon--youtube" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21.6 8.2a2.7 2.7 0 0 0-2-1.9C17.7 6 12 6 12 6s-5.7 0-7.6.3a2.7 2.7 0 0 0-2 1.9A28.4 28.4 0 0 0 2 12a28.4 28.4 0 0 0 .4 3.8 2.7 2.7 0 0 0 2 1.9C6.3 18 12 18 12 18s5.7 0 7.6-.3a2.7 2.7 0 0 0 2-1.9A28.4 28.4 0 0 0 22 12a28.4 28.4 0 0 0-.4-3.8z" stroke="currentColor" stroke-width="1.4" fill="none"/>
    <path d="M10 14.5v-5l4 2.5-4 2.5z" fill="currentColor"/>
  </svg>
{% when 'twitter' %}
  <svg class="icon icon--twitter" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M21 5.9a5.6 5.6 0 0 1-2 .8 3.1 3.1 0 0 0-5.4 2v.7A8.7 8.7 0 0 1 4 6.9s-3 6.9 3.8 10a9.6 9.6 0 0 1-6 1.8c6.8 3.7 15 0 15-8.6a3.5 3.5 0 0 0 0-.5A5.1 5.1 0 0 0 21 5.9z" stroke="currentColor" stroke-width="1.4" fill="none" stroke-linejoin="round"/>
  </svg>
{% else %}
  <span class="icon icon--placeholder" aria-hidden="true">★</span>
{% endcase %}
